{
  "manifest_version": 3,
  "name": "Personal Web TV Controller",
  "version": "2.0",
  "description": "tv-app.html専用のiframe制限解除およびマスター音量制御拡張機能",
  "permissions": [
    "declarativeNetRequest",
    "tabs",
    "tabCapture"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["file:///*tv-app.html*", "http://*/*tv-app.html*", "https://*/*tv-app.html*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}