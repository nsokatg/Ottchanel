{
  "manifest_version": 3,
  "name": "Personal Web TV Controller",
  "version": "2.2",
  "description": "PersonalWebTV専用のiframe制限解除およびマスター音量制御拡張機能",
  "permissions": [
    "declarativeNetRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://nsokatg.github.io/PersonalWebTV/*", "file:///*tv-app.html*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
